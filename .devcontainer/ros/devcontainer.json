{
    "name": "Orthopus explorer stack (ROS2 - Jazzy)",
    "build": {
        "context": "../..",
        "dockerfile": "../../Dockerfile",
        "target": "explorer_ws_dev",
        "cacheFrom": "ghcr.io/orthopus-explorer/explorer_ws/dev:jazzy-latest",
        "args": {
            "ROS_DISTRO": "jazzy"
        }
    },
    "capAdd": ["SYS_NICE", "SYS_PTRACE"],
    "runArgs": [
        "--name=orthopus-explorer-ws-devcontainer",
        // shared memory transport with host, e.g. rviz GUIs
        "--ipc=host",
        // X11 socket for GUI applications
        "--volume=/tmp/.X11-unix:/tmp/.X11-unix",
        // network access to host interfaces, e.g. eth0
        "--network=host",
        "--security-opt=seccomp=unconfined",
        "--ulimit", "rtprio=99",
        "--ulimit", "memlock=-1",
        // Whiteliste all characters devices (tried to whitelist only what's needed but issue regarding /dev/media* devices)
        "--device-cgroup-rule=c *:* rw",
        
        // Whitelist devices : joystick (13: taken from https://www.kernel.org/doc/Documentation/admin-guide/devices.txt)
        // "--device-cgroup-rule=c 13:* rw",
        // Whitelist devices : video4linux camera
        // "--device-cgroup-rule=c 81:* rw",
        // Whitelist devices :  GPU
        // "--device-cgroup-rule=c 226:* rw"

        "--pid=host", // DDS discovery with host, without --network=host
        // Per-machine ROS_DOMAIN_ID, written by initializeCommand.
        "--env-file=${localWorkspaceFolder}/.devcontainer/.env"
        // "--gpus=all" // access to all GPUs, e.g. for GPU-accelerated applications
    ],
    "workspaceFolder": "/root/explorer_ws",
    "workspaceMount": "source=${localWorkspaceFolder},target=${containerWorkspaceFolder},type=bind",
    // Try to pull all private repositories
    "initializeCommand": "if [ -n \"${localEnv:XAUTHORITY}\" ] && [ -f \"${localEnv:XAUTHORITY}\" ]; then cp \"${localEnv:XAUTHORITY}\" ${localWorkspaceFolder}/.devcontainer/.xauthority; elif [ -f \"$HOME/.Xauthority\" ]; then cp \"$HOME/.Xauthority\" ${localWorkspaceFolder}/.devcontainer/.xauthority; else touch ${localWorkspaceFolder}/.devcontainer/.xauthority; fi && chmod 600 ${localWorkspaceFolder}/.devcontainer/.xauthority && bash ${localWorkspaceFolder}/.devcontainer/ros_domain_id.sh && make init",
    "postCreateCommand": "git config --global --add safe.directory '*' && /bin/bash -ci '${containerWorkspaceFolder}/explorer_stack/.devcontainer/build.sh'",
    "postStartCommand": "set_device_permissions.sh",
    "remoteEnv": {
        "DISPLAY": "${localEnv:DISPLAY}", // X11 forwarding
        "XAUTHORITY": "/root/.Xauthority", // Allow access to display through XServer
        "SSH_AUTH_SOCK": "/ssh-agent"
    },
    "mounts": [
        {
            "source": "/run/udev",
            "target": "/run/udev",
            "type": "bind"
        },
        {
            "source": "/dev",
            "target": "/dev",
            "type": "bind"
        },
        {
            "source": "${localEnv:SSH_AUTH_SOCK}",
            "target": "/ssh-agent",
            "type": "bind"
        },
        {
            "source": "${localWorkspaceFolder}/.devcontainer/.xauthority",
            "target": "/root/.Xauthority",
            "type": "bind"
        }
    ],
    "features": {
        "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
    },
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash"
            },
            "extensions": [
                "llvm-vs-code-extensions.vscode-clangd",
                "ranch-hand-robotics.rde-pack",
                "ms-vscode.cmake-tools",
                "charliermarsh.ruff",
                "njpwerner.autodocstring",
                "jakobhoeg.vscode-pokemon",
                "cschlosser.doxdocgen",
            ]
        }
    }
}
